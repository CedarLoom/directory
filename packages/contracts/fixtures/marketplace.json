{
  "name": "example-marketplace",
  "owner": { "name": "Example Org" },
  "plugins": [
    { "name": "relative-path", "source": "./plugins/relative-path" },
    { "name": "bare-name", "source": "bare-name" },
    {
      "name": "github-sha",
      "source": { "source": "github", "repo": "example-org/lint", "sha": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2" }
    },
    { "name": "github-ref", "source": { "source": "github", "repo": "example-org/lint", "ref": "v2.0.0" } },
    { "name": "github-unpinned", "source": { "source": "github", "repo": "example-org/lint" } },
    {
      "name": "url-sha",
      "source": {
        "source": "url",
        "url": "https://gitlab.com/example-org/format.git",
        "sha": "0167bbb411cc972b966127d23c23de801061fa99"
      }
    },
    { "name": "url-unpinned", "source": { "source": "url", "url": "https://gitlab.com/example-org/format.git" } },
    {
      "name": "git-subdir-sha-and-ref",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/example-org/monorepo.git",
        "path": "plugins/deploy",
        "ref": "v1.5.5",
        "sha": "faf5305385de8afed9468904e8639be737aff39e"
      }
    },
    {
      "name": "git-subdir-ref",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/example-org/monorepo.git",
        "path": "plugins/deploy",
        "ref": "main"
      }
    },
    { "name": "npm-exact", "source": { "source": "npm", "package": "@example-org/claude-plugin", "version": "2.1.0" } },
    {
      "name": "npm-range",
      "source": { "source": "npm", "package": "@example-org/claude-plugin", "version": "^2.1.0" }
    },
    { "name": "npm-tag", "source": { "source": "npm", "package": "@example-org/claude-plugin", "version": "latest" } },
    { "name": "npm-unpinned", "source": { "source": "npm", "package": "@example-org/claude-plugin" } },
    { "name": "archive", "source": { "source": "archive", "url": "https://example.org/plugin.zip" } },
    {
      "name": "command",
      "source": { "source": "command", "command": "example-ide plugin path --plugin-format claude", "mode": "link" }
    },
    { "name": "unknown-kind", "source": { "source": "pip", "package": "example-plugin" } }
  ]
}
