{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,63}$",
      "description": "The identifier of the item, never a display name: the manifest or frontmatter `name` of a marketplace, plugin, skill or agent, the registry name of an MCP server, the file stem of an output style (its frontmatter `name` is a display name), and for a hook the name of the plugin folder or repository that holds its hooks file."
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200,
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^https:\\/\\/(?:github\\.com|registry\\.modelcontextprotocol\\.io|www\\.npmjs\\.com|pypi\\.org|skills\\.sh|claude\\.com)(?:\\/[A-Za-z0-9._~%!$&'()*+,;=:@/-]*)?$"
        },
        "homepage": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^https:\\/\\/(?:github\\.com|registry\\.modelcontextprotocol\\.io|www\\.npmjs\\.com|pypi\\.org|skills\\.sh|claude\\.com)(?:\\/[A-Za-z0-9._~%!$&'()*+,;=:@/-]*)?$"
        },
        "install": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^https:\\/\\/(?:github\\.com|registry\\.modelcontextprotocol\\.io|www\\.npmjs\\.com|pypi\\.org|skills\\.sh|claude\\.com)(?:\\/[A-Za-z0-9._~%!$&'()*+,;=:@/-]*)?$"
        },
        "registry": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^https:\\/\\/(?:github\\.com|registry\\.modelcontextprotocol\\.io|www\\.npmjs\\.com|pypi\\.org|skills\\.sh|claude\\.com)(?:\\/[A-Za-z0-9._~%!$&'()*+,;=:@/-]*)?$"
        }
      },
      "additionalProperties": false
    },
    "container": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "listedIn": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200,
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "spdx": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9.+()-](?:[A-Za-z0-9.+() -]*[A-Za-z0-9.+()-])?$",
          "description": "An SPDX license expression (SPDX 2.3, Annex D) of SPDX License List ids and LicenseRefs, as the item states it."
        },
        "source": {
          "type": "string",
          "enum": [
            "github-detected",
            "manifest",
            "frontmatter",
            "license-file"
          ]
        },
        "class": {
          "type": "string",
          "enum": [
            "permissive",
            "copyleft",
            "source-available",
            "none"
          ]
        }
      },
      "required": [
        "class"
      ],
      "additionalProperties": false
    },
    "maintenance": {
      "type": "object",
      "properties": {
        "pushedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "recentCommits": {
          "type": "string",
          "enum": [
            "none",
            "1-4",
            "5+"
          ]
        },
        "latestRelease": {
          "type": "object",
          "properties": {
            "tag": {
              "type": "string",
              "pattern": "^[0-9A-Za-z][0-9A-Za-z._+/-]{0,63}$"
            },
            "date": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          },
          "required": [
            "tag",
            "date"
          ],
          "additionalProperties": false
        },
        "archived": {
          "type": "boolean"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "pushedAt",
        "recentCommits",
        "archived",
        "headSha"
      ],
      "additionalProperties": false
    },
    "popularity": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "signal": {
                "type": "string",
                "const": "listed"
              },
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "scope": {
                "type": "string",
                "enum": [
                  "item",
                  "repository",
                  "marketplace"
                ]
              },
              "source": {
                "type": "string",
                "enum": [
                  "official-marketplace",
                  "community-marketplace",
                  "anthropic-marketplaces",
                  "github",
                  "mcp-registry",
                  "seeds"
                ]
              }
            },
            "required": [
              "signal",
              "value",
              "scope",
              "source"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "signal": {
                "type": "string",
                "enum": [
                  "stars",
                  "starsGained30d"
                ]
              },
              "ref": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[a-z0-9][a-z0-9._-]*$",
                "description": "The id `gh.<owner>.<repo>` of the popularity file that holds the star snapshots."
              },
              "scope": {
                "type": "string",
                "const": "repository"
              },
              "source": {
                "type": "string",
                "const": "github"
              }
            },
            "required": [
              "signal",
              "ref",
              "scope",
              "source"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "signals": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": [
          "number",
          "boolean"
        ]
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "hook-shell-command",
          "hook-session-start",
          "hook-match-all",
          "hook-http",
          "monitor-background-command",
          "bin-executables",
          "scripts-present",
          "network-indicator",
          "mcp-stdio-unpinned-package",
          "mcp-remote",
          "mcp-secrets-required",
          "allowed-tools-unrestricted-bash",
          "agent-inherits-all-tools",
          "install-command-source",
          "unpinned-source",
          "listed-official-marketplace"
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "cedarloomFit": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "complements",
            "overlaps",
            "may-conflict",
            "not-assessed"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      },
      "required": [
        "label",
        "tags"
      ],
      "additionalProperties": false
    },
    "score": {
      "description": "Stored apart from the raw signals; optional, and absent while no rubric has scored the record.",
      "type": "object",
      "properties": {
        "rubric": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "marketplace",
                "plugin",
                "skill",
                "agent",
                "hook",
                "mcp-server",
                "output-style"
              ]
            },
            "version": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$"
            }
          },
          "required": [
            "kind",
            "version"
          ],
          "additionalProperties": false
        },
        "total": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "signal": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "points": {
                "type": "number",
                "minimum": 0
              },
              "max": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "signal",
              "points",
              "max"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "rubric",
        "total",
        "parts"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "official-marketplace",
          "community-marketplace",
          "anthropic-marketplaces",
          "github",
          "mcp-registry",
          "seeds"
        ]
      }
    },
    "changedAt": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "kind": {
      "type": "string",
      "const": "hook"
    },
    "events": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      }
    },
    "handlerTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "command",
          "http",
          "prompt",
          "agent"
        ]
      }
    },
    "commandForms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "shell",
          "exec"
        ]
      }
    },
    "matcherBreadth": {
      "type": "string",
      "enum": [
        "match-all",
        "specific",
        "none"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "aliases",
    "links",
    "listedIn",
    "license",
    "popularity",
    "signals",
    "flags",
    "tags",
    "cedarloomFit",
    "provenance",
    "changedAt",
    "kind",
    "events",
    "handlerTypes",
    "commandForms",
    "matcherBreadth"
  ],
  "additionalProperties": false
}
