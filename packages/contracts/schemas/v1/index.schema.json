{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "kind": {
                "type": "string",
                "const": "mcp-server"
              },
              "name": {
                "type": "string",
                "minLength": 3,
                "maxLength": 200,
                "pattern": "^[a-zA-Z0-9.-]+\\/[a-zA-Z0-9._-]+$"
              },
              "owner": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,63}$"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "stars": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "starsGained30d": {
                "description": "Current stars minus the newest snapshot 30 or more days before the run date; negative when unstars outweigh stars; absent while no snapshot is that old.",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "licenseClass": {
                "type": "string",
                "enum": [
                  "permissive",
                  "copyleft",
                  "source-available",
                  "none",
                  "withheld"
                ],
                "description": "The class of the license; `withheld` where the license field of the item withholds the license."
              },
              "fit": {
                "type": "string",
                "enum": [
                  "complements",
                  "overlaps",
                  "may-conflict",
                  "not-assessed"
                ]
              },
              "listedOfficial": {
                "type": "boolean"
              },
              "pushedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "archived": {
                "type": "boolean"
              },
              "flagCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              }
            },
            "required": [
              "id",
              "kind",
              "name",
              "licenseClass",
              "fit",
              "listedOfficial",
              "archived",
              "flagCount",
              "tags"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "marketplace",
                  "plugin",
                  "skill",
                  "agent",
                  "hook",
                  "output-style"
                ]
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,63}$"
              },
              "owner": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,63}$"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "stars": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "starsGained30d": {
                "description": "Current stars minus the newest snapshot 30 or more days before the run date; negative when unstars outweigh stars; absent while no snapshot is that old.",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "licenseClass": {
                "type": "string",
                "enum": [
                  "permissive",
                  "copyleft",
                  "source-available",
                  "none",
                  "withheld"
                ],
                "description": "The class of the license; `withheld` where the license field of the item withholds the license."
              },
              "fit": {
                "type": "string",
                "enum": [
                  "complements",
                  "overlaps",
                  "may-conflict",
                  "not-assessed"
                ]
              },
              "listedOfficial": {
                "type": "boolean"
              },
              "pushedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "archived": {
                "type": "boolean"
              },
              "flagCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              }
            },
            "required": [
              "id",
              "kind",
              "name",
              "licenseClass",
              "fit",
              "listedOfficial",
              "archived",
              "flagCount",
              "tags"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "items"
  ],
  "additionalProperties": false
}
