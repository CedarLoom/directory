{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "marketplace",
        "plugin",
        "skill",
        "agent",
        "hook",
        "mcp-server",
        "output-style"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "rubric": {
            "type": "string",
            "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$"
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "The score total rounded to an integer."
          }
        },
        "required": [
          "date",
          "rubric",
          "total"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "entries"
  ],
  "additionalProperties": false
}
