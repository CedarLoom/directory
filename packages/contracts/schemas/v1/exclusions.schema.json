{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "description": "The HMAC-SHA-256 of each excluded id under the secret exclusions key, as lowercase hex."
    }
  },
  "required": [
    "schemaVersion",
    "hashes"
  ],
  "additionalProperties": false
}
